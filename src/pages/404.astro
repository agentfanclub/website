---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderSection from "../components/sections/HeaderSection.astro";
---

<BaseLayout title="Page not found - Agent Fan Club">
  <HeaderSection />
  <main class="hue-vermilion mx-auto w-full max-w-4xl px-6 pb-40 pt-32">
    <h1 class="text-[2rem] font-semibold leading-[1.15] tracking-[-0.02em] md:text-[2.5rem]">
      Page not found
    </h1>
    <p class="mt-5 text-lg leading-[1.6] text-muted">
      The link is broken, or the page moved. Error 404.
    </p>
    <a href="/" class="btn btn-quiet mt-10">Go to the homepage</a>
  </main>
</BaseLayout>
