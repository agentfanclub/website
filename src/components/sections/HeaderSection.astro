---
const nav = [
  { label: "Projects", href: "/#projects", hue: "hue-jade" },
  { label: "Sponsors", href: "/#sponsors", hue: "hue-saffron" },
  { label: "Blog", href: "/blogs", hue: "hue-magenta" },
];
---

<header class="mx-auto flex w-full max-w-4xl items-center justify-between gap-6 px-6 pt-8">
  <a href="/" class="text-[15px] font-semibold tracking-[-0.01em] text-ink">Agent Fan Club</a>

  <nav class="flex items-center gap-5 text-sm text-muted sm:gap-6">
    {
      nav.map((item) => (
        <a href={item.href} class:list={[item.hue, "hidden items-center gap-2 hover:text-hue-ink sm:inline-flex"]}>
          <span class="dot" aria-hidden="true" />
          {item.label}
        </a>
      ))
    }
    <a
      href="https://discord.gg/gWUnUwenSV"
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-cobalt-ink underline decoration-cobalt/30 decoration-1 underline-offset-4 hover:decoration-cobalt"
    >
      Join Discord
    </a>
  </nav>
</header>
