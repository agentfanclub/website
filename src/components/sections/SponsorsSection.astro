---
import SectionLabel from "../ui/SectionLabel.astro";
import Callout from "../ui/Callout.astro";
import { getCollection } from 'astro:content';

const sponsorsCollection = await getCollection('sponsors');
// Sort by order
sponsorsCollection.sort((a, b) => a.data.order - b.data.order);

const sponsors = sponsorsCollection.map((sponsor) => ({
  name: sponsor.data.name,
  tier: sponsor.data.tier,
  logo: sponsor.data.logo,
}));

// Tier colors: gold in saffron, silver in cool grey, bronze in copper.
const tierHue = {
  Gold: "hue-saffron",
  Silver: "hue-silver",
  Bronze: "hue-bronze",
} as const;

const benefits = [
  { title: "Recruiting", desc: "Meet skilled students directly." },
  { title: "Brand visibility", desc: "Your logo on our site, our social accounts, and every event." },
  { title: "Workshops", desc: "Give talks and run technical sessions." },
  { title: "Project collaboration", desc: "Sponsor specific student projects." },
];
---

<section id="sponsors" class="hue-saffron scroll-mt-12 py-16 md:py-20">
  <SectionLabel title="Sponsors" />

  <div class="space-y-6 text-base leading-[1.7]">
    <p>
      Sponsorships from companies and institutions pay for agent subscriptions, compute, and events. In return,
      sponsors get direct access to students who build with AI.
    </p>

    <Callout type="info">
      Our exec board and ACM @ UIUC review and approve every sponsorship agreement. We don't accept exclusive
      recruiting arrangements.
    </Callout>
  </div>

  <div class="mt-14">
    <h3 class="text-base font-semibold">Current sponsors, fall 2026</h3>
    <ul class="mt-3 divide-y divide-line border-t-2 border-b border-t-hue border-b-line">
      {
        sponsors.map((sponsor) => (
          <li class="flex items-center justify-between gap-4 py-4">
            <span class="flex items-center gap-3">
              <img src={sponsor.logo} alt="" class="size-5 object-contain" loading="lazy" />
              <span class="font-medium">{sponsor.name}</span>
            </span>
            <span class:list={[tierHue[sponsor.tier], "tag"]}>{sponsor.tier}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-14">
    <h3 class="text-base font-semibold">What sponsors get</h3>
    <dl class="mt-5 grid gap-x-8 gap-y-6 sm:grid-cols-2">
      {
        benefits.map((benefit) => (
          <div>
            <dt class="flex items-center gap-2.5 font-medium"><span class="dot" aria-hidden="true" />{benefit.title}</dt>
            <dd class="mt-1 pl-[1.0625rem] text-[15px] leading-[1.6] text-muted">{benefit.desc}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="mt-14 flex flex-wrap items-center gap-x-6 gap-y-4">
    <a href="mailto:sponsors@agentfanclub.org" class="btn btn-quiet">Become a sponsor</a>
    <a href="mailto:sponsors@agentfanclub.org" class="link text-sm text-muted">sponsors@agentfanclub.org</a>
  </div>
</section>
