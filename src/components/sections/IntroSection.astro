---
import SectionLabel from "../ui/SectionLabel.astro";
import Callout from "../ui/Callout.astro";
import { getCollection } from 'astro:content';

const staticStats = await getCollection('stats');
const discordStats = await getCollection('discordStats');
const projectsCollection = await getCollection('projects');
const activeProjectCount = projectsCollection.filter(
  (project) => project.data.status === 'Active',
).length;

const allStats = [
  ...staticStats.map((stat) => ({
    label: stat.data.label,
    value: stat.data.value,
    order: stat.data.order,
  })),
  {
    label: 'Projects',
    value: `${activeProjectCount} Active`,
    order: 3,
  },
  ...discordStats.map((stat) => ({
    label: stat.data.label,
    value: stat.data.value,
    order: stat.data.order,
  })),
].sort((a, b) => a.order - b.order);

const statHues = ['hue-cobalt', 'hue-vermilion', 'hue-jade', 'hue-saffron', 'hue-magenta'];

const stats = allStats.map((stat, i) => ({
  label: stat.label,
  value: stat.value,
  hue: statHues[i % statHues.length],
}));
---

<section class="hue-cobalt pb-20 pt-24 md:pb-24 md:pt-32">
  <h1 class="text-[2.5rem] font-semibold leading-[1.05] tracking-[-0.03em] md:text-[3.25rem]">
    Agent Fan Club
  </h1>
  <p class="mt-6 max-w-[34rem] text-lg leading-[1.6] text-muted">
    Agent Fan Club is a student organization in the Association for Computing Machinery at the University of
    Illinois Urbana-Champaign. We learn about, research, and build with agentic AI.
  </p>

  <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
    <a
      href="https://discord.gg/gWUnUwenSV"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary"
    >
      Join Discord
    </a>
  </div>

  <dl class="mt-20 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4" aria-label="Quick facts">
    {
      stats.map((stat) => (
        <div class:list={[stat.hue, "border-t-2 border-hue pt-4"]}>
          <dt class="text-sm text-hue-ink">{stat.label}</dt>
          <dd class="mt-1 text-[15px] font-medium tabular-nums">{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<section id="overview" class="hue-cobalt scroll-mt-12 py-16 md:py-20">
  <SectionLabel title="Overview" />

  <div class="space-y-6 text-base leading-[1.7]">
    <p>
      We give people hands-on experience with real AI tools so they can learn by doing. We try out new ways to
      work with these tools, and we share what we learn about AI tools and agent-based systems with the rest of
      campus.
    </p>

    <Callout type="info">
      Any UIUC student can join, whatever their technical background. You don't need prior AI experience.
    </Callout>
  </div>

  <div class="mt-14">
    <h3 class="text-base font-semibold">Meetings</h3>
    <p class="mt-2 text-base leading-[1.7] text-muted">
      We meet every Wednesday from 7:00 to 8:00 PM in the Siebel Center for Computer Science, room 1302.
    </p>
  </div>

  <div class="mt-10">
    <h3 class="text-base font-semibold">Affiliations</h3>
    <p class="mt-2 text-base leading-[1.7] text-muted">
      We are part of ACM @ UIUC at the University of Illinois Urbana-Champaign.
    </p>
  </div>
</section>
