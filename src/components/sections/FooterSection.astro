---
import { getCollection } from 'astro:content';

const discordStats = await getCollection('discordStats');
const membersEntry = discordStats.find((s) => s.id === 'members');
const memberCount = membersEntry
  ? membersEntry.data.value.replace(/\D+$/, '')
  : null;

const sectionLinks = [
  { label: "Overview", href: "/#overview", hue: "hue-cobalt" },
  { label: "Leadership", href: "/#leadership", hue: "hue-vermilion" },
  { label: "Projects", href: "/#projects", hue: "hue-jade" },
  { label: "Sponsors", href: "/#sponsors", hue: "hue-saffron" },
  { label: "Blog", href: "/#blog", hue: "hue-magenta" },
];

const connectLinks = [
  { label: "Discord", url: "https://discord.gg/gWUnUwenSV" },
  { label: "GitHub", url: "https://github.com/agentfanclub" },
  { label: "hello@agentfanclub.org", url: "mailto:hello@agentfanclub.org" },
  { label: "Twitter/X", url: "https://x.com/agentsfanclub" },
];
---

<footer class="mx-auto mt-16 w-full max-w-4xl px-6 pb-16">
  <div class="border-t border-line pt-14">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
      <p class="text-base">
        {memberCount ? `${memberCount}+ students talk about AI agents on our Discord.` : "Students talk about AI agents on our Discord."}
      </p>
      <a
        href="https://discord.gg/gWUnUwenSV"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Join Discord
      </a>
    </div>

    <div class="mt-16 grid grid-cols-2 gap-8 text-sm sm:grid-cols-[1.4fr_1fr_1fr]">
      <div class="col-span-2 sm:col-span-1">
        <p class="font-semibold">Agent Fan Club</p>
        <address class="mt-3 space-y-0.5 not-italic leading-relaxed text-muted">
          <p>University of Illinois Urbana-Champaign</p>
          <p>Siebel Center for Computer Science</p>
          <p>201 N Goodwin Ave, Urbana, IL 61801</p>
        </address>
      </div>

      <nav aria-label="Sections">
        <p class="font-medium text-ink">Sections</p>
        <ul class="mt-3 space-y-2">
          {
            sectionLinks.map((item) => (
              <li>
                <a href={item.href} class:list={[item.hue, "inline-flex items-center gap-2 text-muted hover:text-hue-ink"]}>
                  <span class="dot" aria-hidden="true" />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="font-medium text-ink">Connect</p>
        <ul class="mt-3 space-y-2">
          {
            connectLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  target={link.url.startsWith("http") ? "_blank" : undefined}
                  rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="break-all text-muted hover:text-cobalt-ink"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-16 text-sm leading-relaxed text-muted">
      &copy;{new Date().getFullYear()} Agent Fan Club. ACM@UIUC is a 501(c)(3) non-profit organization.
    </p>
  </div>
</footer>
