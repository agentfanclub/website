---
import SectionLabel from "../ui/SectionLabel.astro";
import { getCollection } from 'astro:content';

const postsCollection = await getCollection('blog');
postsCollection.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const latestPosts = postsCollection.slice(0, 5);
const totalCount = postsCollection.length;

const posts = latestPosts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  date: post.data.date,
  author: post.data.author,
  readTime: post.data.readTime,
}));
---

<section id="blog" class="hue-magenta scroll-mt-12 py-16 md:py-20">
  <SectionLabel title="Blog and documentation" />

  {
    posts.length > 0 ? (
      <ul class="divide-y divide-line border-t-2 border-b border-t-hue border-b-line">
        {posts.map((post) => (
          <li>
            <a href={`/blogs/${post.slug}`} class="group grid gap-1 py-5 sm:grid-cols-[7.5rem_1fr] sm:gap-6">
              <span class="text-sm leading-6 text-hue-ink tabular-nums">{post.date}</span>
              <span>
                <span class="block font-medium group-hover:text-hue-ink">{post.title}</span>
                <span class="mt-1 flex flex-wrap gap-x-4 text-sm text-muted">
                  <span>{post.author}</span>
                  <span>{post.readTime}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-base text-muted">No posts yet.</p>
    )
  }

  {
    totalCount > 0 && (
      <a href="/blogs" class="link mt-8 inline-block text-sm">
        All {totalCount} posts
      </a>
    )
  }
</section>
