---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!-- The dot matches the section's dot in the nav and footer, so the heading carries its hue. -->
<h2 class="mb-8 flex items-center gap-3 text-xl font-semibold tracking-[-0.01em] text-ink">
  <span class="size-2.5 shrink-0 rounded-full bg-hue" aria-hidden="true"></span>
  {title}
</h2>
